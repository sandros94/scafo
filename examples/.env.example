# Copy to `.env`; Compose refuses blank required values.

# Exact released Scafo image tag.
SCAFO_VERSION=

# Released scafo-caddy tag. This image includes `caddy.storage.scafo`.
SCAFO_CADDY_VERSION=0.2.0

# Pre-created S3-compatible registry store. It must support conditional writes.
SCAFO_S3_ENDPOINT=
SCAFO_S3_BUCKET=
SCAFO_S3_ACCESS_KEY=
SCAFO_S3_SECRET_KEY=

# Safe registry defaults. One bucket/prefix pair defines one fleet.
SCAFO_S3_REGION=us-east-1
SCAFO_S3_PREFIX=scafo

# Public platform apex, such as `apps.example.com`; no scheme or wildcard.
SCAFO_PLATFORM_DOMAINS=

# Bearer token for Caddy's loopback storage API. Generate with `openssl rand -base64 32`.
SCAFO_STORAGE_TOKEN=
