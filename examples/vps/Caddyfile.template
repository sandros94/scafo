{
	# ACME contact address. @DOMAIN@, @NODE@ and @LOGS@ are filled in per host by
	# roll-node.sh; this line and the `dns` one below are yours to edit.
	email you@example.com
	# The fleet, declared once: every scafo module below reads it from here.
	# `{env.…}` is resolved at provisioning, so the token never lands in the
	# adapted configuration.
	scafo {
		fleet default {
			endpoint http://@NODE@
			token {env.SCAFO_INGRESS_TOKEN}
			prefer self
		}
	}
	# Certificates and locks go to the fleet's bucket through the node. The ACME
	# account is the ingress's own and stays under /data.
	storage scafo
	# A customer domain is issued for only once the fleet's routing names it.
	on_demand_tls {
		permission scafo
	}
}

(scafo) {
	log {
		# Readable by the node, which runs as another user and counts requests from
		# it: Caddy creates its log files 0600 otherwise.
		output file @LOGS@/access.log {
			mode 0644
		}
		format json
	}
	reverse_proxy {
		dynamic scafo
		# The node returns upstreams in priority order, this node's own first, so
		# `first` keeps a request on the machine it arrived at. `max_fails 1` is
		# what lets a retry move on: `first` skips only upstreams already marked
		# down, and a higher count would send every retry back to the dead one.
		lb_policy first
		lb_retries 2
		fail_duration 30s
		max_fails 1
	}
	handle_errors {
		@missing vars scafo.route unknown denied
		handle @missing {
			respond "scafo: no deployment answers to {http.vars.scafo.host}" 404
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}

# The platform domain and every deployment under it, on one DNS-01 wildcard.
# The `-dns` image carries bunny, cloudflare, digitalocean, hetzner, ovh and
# route53; name the zone's provider and the variable ingress.env holds its
# credential in, which is `DNS_ENV` in the roll script's env file.
*.@DOMAIN@, @DOMAIN@ {
	tls {
		dns bunny {env.BUNNY_API_KEY}
	}
	import scafo
}

# Customer domains pointed at this fleet, issued per name once the fleet's
# routing document names them.
https:// {
	tls {
		on_demand
	}
	import scafo
}
