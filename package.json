{
  "name": "scafo",
  "version": "0.0.0",
  "description": "Self-hosted serverless deployment platform for JS apps",
  "license": "Apache-2.0",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandros94/scafo.git"
  },
  "bin": {
    "scafo": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./registry": {
      "types": "./dist/core/registry/index.d.mts",
      "default": "./dist/core/registry/index.mjs"
    },
    "./auth": {
      "types": "./dist/core/auth/index.d.mts",
      "default": "./dist/core/auth/index.mjs"
    },
    "./capacity": {
      "types": "./dist/core/capacity/index.d.mts",
      "default": "./dist/core/capacity/index.mjs"
    },
    "./placement": {
      "types": "./dist/core/placement/index.d.mts",
      "default": "./dist/core/placement/index.mjs"
    },
    "./agent": {
      "types": "./dist/agent/index.d.mts",
      "default": "./dist/agent/index.mjs"
    },
    "./drivers/host/node": {
      "types": "./dist/drivers/host/node.d.mts",
      "default": "./dist/drivers/host/node.mjs"
    },
    "./drivers/store/uns3": {
      "types": "./dist/drivers/store/uns3.d.mts",
      "default": "./dist/drivers/store/uns3.mjs"
    },
    "./drivers/store/memory": {
      "types": "./dist/drivers/store/memory.d.mts",
      "default": "./dist/drivers/store/memory.mjs"
    },
    "./drivers/runtime/celld": {
      "types": "./dist/drivers/runtime/celld.d.mts",
      "default": "./dist/drivers/runtime/celld.mjs"
    },
    "./drivers/supervisor/child": {
      "types": "./dist/drivers/supervisor/child.d.mts",
      "default": "./dist/drivers/supervisor/child.mjs"
    },
    "./drivers/ingress/caddy": {
      "types": "./dist/drivers/ingress/caddy.d.mts",
      "default": "./dist/drivers/ingress/caddy.mjs"
    },
    "./drivers/ingress/traefik": {
      "types": "./dist/drivers/ingress/traefik.d.mts",
      "default": "./dist/drivers/ingress/traefik.mjs"
    },
    "./drivers/deploy/celld": {
      "types": "./dist/drivers/deploy/celld.d.mts",
      "default": "./dist/drivers/deploy/celld.mjs"
    },
    "./drivers/archive/tar-zst": {
      "types": "./dist/drivers/archive/tar-zst.d.mts",
      "default": "./dist/drivers/archive/tar-zst.mjs"
    },
    "./drivers/observe/access-log": {
      "types": "./dist/drivers/observe/access-log.d.mts",
      "default": "./dist/drivers/observe/access-log.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "compile": "./scripts/compile.sh",
    "dev": "bun --watch ./playground/main.ts",
    "dev:prepare": "obuild --stub && pnpm simple-git-hooks",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run --slowTestThreshold=1000",
    "test:coverage": "vitest run --coverage --slowTestThreshold=1000",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "confbox": "^0.2.4",
    "esbuild": "^0.28.2",
    "h3": "2.0.1-rc.26",
    "tar": "^7.5.22",
    "tavolato": "https://pkg.pr.new/sandros94/tavolato@dba2283",
    "unjwt": "^0.7.3",
    "uns3": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4.1.10",
    "automd": "^0.4.3",
    "obuild": "^0.4.38",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build --stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.18.0"
}
