# Copy to `.env` before bringing the stack up. Compose reads `.env` from this
# directory automatically and refuses to start if any of these is missing or
# empty, rather than starting something half-configured.
#
#   cp .env.example .env

# THE ONE VALUE EVERY AGENT AND EVERY INGRESS HERE SHARES. Each node admits it
# on its own /v1/storage; each Caddy presents it to the node it shares a network
# namespace with. Nothing crosses between the pairs — node A's Caddy never talks
# to node B — but there is no reason for a fleet to hold two different tokens,
# and every reason for the operator to hold one.
#
#   openssl rand -base64 32
#
# Empty is not the same as absent: a node handed an empty token refuses to boot.
SCAFO_STORAGE_TOKEN=playground-storage-token-change-me

# The bucket's credentials. Fake, local, thrown away with the volume.
SCAFO_S3_ACCESS_KEY=scafo
SCAFO_S3_SECRET_KEY=scafo-secret

# The five ports this stack publishes. TWO INGRESSES MEANS TWO ADDRESSES, and
# that is not an artifact of putting them on one machine — it is what a fleet
# looks like before something is put in front of it. Real installations point a
# wildcard DNS record, or a load balancer, at all of them.
#
#   SCAFO_A_HTTP_PORT=8081     node A's ingress
#   SCAFO_B_HTTP_PORT=8082     node B's ingress
#   SCAFO_A_AGENT_PORT=7401    node A's agent API
#   SCAFO_B_AGENT_PORT=7402    node B's agent API
#   SCAFO_STORE_PORT=8333      the bucket
#
# Neither ingress takes port 80: with two of them, neither could have it, and
# claiming it for one would make the pair look asymmetric when it is not.
# Everything but the two ingresses is bound to 127.0.0.1.

# Who the one-shot `cli` service runs as. It writes the operator key into this
# directory, which belongs to you and not to the image's uid 10001. If
# `docker compose run --rm cli …` fails with a permission error, put your own
# `id -u`:`id -g` here.
SCAFO_CLI_USER=1000:1000
