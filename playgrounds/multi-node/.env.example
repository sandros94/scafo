# Copy to `.env` before bringing the stack up.
#
#   cp .env.example .env
#
# The step sheet also sources this file into your shell, so the CLI reads the
# same bucket the nodes do.

# THE ONE VALUE EVERY AGENT AND EVERY INGRESS HERE SHARES. Each node admits it on
# its own /v1/storage; each Caddy presents it to the node it shares a network
# namespace with. Nothing crosses between the pairs.
#
# EMPTY IS NOT THE SAME AS ABSENT: a node handed an empty token refuses to boot.
# A real one is `openssl rand -base64 32`.
SCAFO_STORAGE_TOKEN=playground-storage-token-change-me

# The bucket's credentials. Fake, local, thrown away with the volume.
SCAFO_S3_ACCESS_KEY=scafo
SCAFO_S3_SECRET_KEY=scafo-secret

# Where the CLI on YOUR machine reaches the bucket. Compose ignores this — the
# nodes reach the same bucket at http://seaweedfs:8333 over their own network —
# but scafo.config.jsonc names that internal address, which does not resolve from
# out here. Change it and SCAFO_STORE_PORT below together.
SCAFO_S3_ENDPOINT=http://127.0.0.1:8333

# The five ports this stack publishes. TWO INGRESSES MEANS TWO ADDRESSES, and
# that is not an artifact of putting them on one machine — it is what a fleet
# looks like before something is put in front of it.
#
#   SCAFO_A_HTTP_PORT=8081     node A's ingress
#   SCAFO_B_HTTP_PORT=8082     node B's ingress
#   SCAFO_A_AGENT_PORT=7401    node A's agent API
#   SCAFO_B_AGENT_PORT=7402    node B's agent API
#   SCAFO_STORE_PORT=8333      the bucket
#
# Everything but the two ingresses is bound to 127.0.0.1.

# Who the `cli` container runs as, for the container form of step 2. It writes
# into this directory, which is yours and not the image's uid 10001.
SCAFO_CLI_USER=1000:1000
