{
  "bucket": {
    "endpoint": "http://seaweedfs:8333",
    "bucket": "scafo",
    "prefix": "playground",
    "region": "us-east-1",
  },

  "node": {
    // Caddy and peer nodes reach this listener through the Docker network.
    "listen": "0.0.0.0:7400",
  },

  "platformDomains": ["scafo.test"],

  "transport": { "driver": "none" },

  "runtime": {
    // Required for cross-node Celld forwarding; use only a trusted transport.
    "bindHost": "0.0.0.0",
  },

  "ingress": {
    "driver": "caddy",
    "adminUrl": "http://127.0.0.1:2019",
    "serverName": "scafo",
  },

  "observability": {
    "enabled": true,
    "ingressAccessLog": "/var/log/scafo-ingress/access.log",
  },
}
