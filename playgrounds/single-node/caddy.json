{
  "storage": {
    "module": "scafo",
    "endpoint": "http://127.0.0.1:7400",
    "token": "{env.SCAFO_INGRESS_TOKEN}"
  },
  "logging": {
    "logs": {
      "default": { "exclude": ["http.log.access.scafo"] },
      "scafo": {
        "writer": {
          "output": "file",
          "filename": "/var/log/scafo-ingress/access.log",
          "mode": "0644"
        },
        "encoder": { "format": "json" },
        "include": ["http.log.access.scafo"]
      }
    }
  },
  "apps": {
    "http": {
      "servers": {
        "scafo": {
          "listen": [":80"],
          "routes": [
            {
              "@id": "operator_authored",
              "match": [{ "host": ["operator.test"] }],
              "handle": [
                { "handler": "static_response", "status_code": 200, "body": "written by hand\n" }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "dynamic_upstreams": {
                    "source": "scafo",
                    "endpoint": "http://127.0.0.1:7400",
                    "token": "{env.SCAFO_INGRESS_TOKEN}",
                    "prefer": "self"
                  },
                  "load_balancing": {
                    "selection_policy": { "policy": "first" },
                    "retries": 2,
                    "try_duration": "5s"
                  },
                  "health_checks": {
                    "passive": { "fail_duration": "30s", "max_fails": 3 }
                  }
                }
              ]
            }
          ],
          "errors": {
            "routes": [
              {
                "match": [{ "vars": { "scafo.route": ["unknown", "denied"] } }],
                "handle": [
                  {
                    "handler": "static_response",
                    "status_code": 404,
                    "body": "No deployment answers to this name.\n"
                  }
                ]
              }
            ]
          },
          "logs": { "default_logger_name": "scafo" }
        }
      }
    }
  }
}
