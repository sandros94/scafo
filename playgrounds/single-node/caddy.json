{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "storage": {
    "module": "scafo",
    "endpoint": "http://127.0.0.1:7400",
    "token": "{env.SCAFO_INGRESS_TOKEN}"
  },
  "logging": {
    "logs": {
      "default": { "exclude": ["http.log.access.scafo"] },
      "scafo": {
        "writer": {
          "output": "file",
          "filename": "/var/log/scafo-ingress/access.log",
          "mode": "0644"
        },
        "encoder": { "format": "json" },
        "include": ["http.log.access.scafo"]
      }
    }
  },
  "apps": {
    "http": {
      "servers": {
        "scafo": {
          "listen": [":80"],
          "routes": [
            {
              "@id": "operator_authored",
              "match": [{ "host": ["operator.test"] }],
              "handle": [
                { "handler": "static_response", "status_code": 200, "body": "written by hand\n" }
              ],
              "terminal": true
            }
          ],
          "logs": { "default_logger_name": "scafo" }
        }
      }
    }
  }
}
