# Copy to `.env`; the walkthrough also sources it for the local CLI.
# Ingress token Caddy presents for `/v1/storage` and `/v1/ingress/routes`; it must be non-empty.
# Generate one with `openssl rand -base64 32`.
SCAFO_INGRESS_TOKEN=playground-ingress-token-change-me

# Local bucket credentials; replace for a non-disposable store.
SCAFO_S3_ACCESS_KEY=scafo
SCAFO_S3_SECRET_KEY=scafo-secret

# Host address for the CLI; Compose uses `http://seaweedfs:8333` internally.
SCAFO_S3_ENDPOINT=http://127.0.0.1:8333

# Compose defaults to ingress :80, node API :7400, and bucket :8333.
# The API and bucket bind to loopback; only ingress accepts application traffic.
# Container CLI user; set to your uid:gid when 1000:1000 cannot write `.scafo`.
SCAFO_CLI_USER=1000:1000

# Optional local-image overrides.
# SCAFO_IMAGE=scafo:local
# SCAFO_CADDY_IMAGE=ghcr.io/sandros94/scafo-caddy:edge
