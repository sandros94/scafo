# Copy to `.env` before bringing the stack up.
#
#   cp .env.example .env
#
# The step sheet also sources this file into your shell, so the CLI reads the
# same bucket the node does.

# THE ONE VALUE THE DAEMON AND ITS INGRESS SHARE. The daemon admits it on
# /v1/storage; Caddy presents it there to keep its certificates, their keys and
# its ACME account in the bucket without ever holding a bucket credential.
#
# EMPTY IS NOT THE SAME AS ABSENT: an empty token admits a caller presenting
# nothing, so a node handed one refuses to boot and compose refuses first.
# A real one is `openssl rand -base64 32`.
SCAFO_STORAGE_TOKEN=playground-storage-token-change-me

# The bucket's credentials. Fake, local, thrown away with the volume.
SCAFO_S3_ACCESS_KEY=scafo
SCAFO_S3_SECRET_KEY=scafo-secret

# Where the CLI on YOUR machine reaches the bucket. Compose ignores this — the
# node reaches the same bucket at http://seaweedfs:8333 over its own network —
# but scafo.config.jsonc names that internal address, and from out here it does
# not resolve. Change it and SCAFO_STORE_PORT below together.
SCAFO_S3_ENDPOINT=http://127.0.0.1:8333

# The three ports this stack publishes. Change one when this machine already has
# it: a `docker compose up` onto a taken port fails naming the port and not the
# service that wanted it.
#
#   SCAFO_HTTP_PORT=80             the ingress, where applications answer
#   SCAFO_NODE_PORT=7400           the node API, where deploys are accepted
#   SCAFO_STORE_PORT=8333          the bucket, where the registry lives
#
# All bound to 127.0.0.1 except the ingress, the only surface meant to take
# traffic.

# Who the `cli` container runs as, for the container form of step 4. It writes
# into this directory, which is yours and not the image's uid 10001.
SCAFO_CLI_USER=1000:1000
