{
  "bucket": {
    "endpoint": "http://seaweedfs:8333",
    "bucket": "scafo",
    "prefix": "playground",
    "region": "us-east-1",
  },

  "node": {
    // Published for host access; Caddy uses shared loopback.
    "listen": "0.0.0.0:7400",
    "advertise": "127.0.0.1:7400",
  },

  "platformDomains": ["scafo.test"],

  "transport": { "driver": "none" },

  "observability": {
    "enabled": true,
    "ingressAccessLog": "/var/log/scafo-ingress/access.log",
  },
}
