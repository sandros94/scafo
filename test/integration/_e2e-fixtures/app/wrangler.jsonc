{
  /* The end-to-end fixture application. `name` is rewritten by the deploy runner
     to the script name scalo recorded, so its value here is only a placeholder.

     The counter is what makes a multi-node run meaningful: one cell owns it
     however many nodes serve the environment, so a count that keeps rising
     across both of them is the fleet agreeing on a single owner. SQLite-backed
     classes are the only kind this runtime migrates. */
  "name": "app",
  "main": "index.js",
  "compatibility_date": "2025-01-01",
  "vars": { "APP_VERSION": "v1" },
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
}
