{
  "admin": { "disabled": true },
  "apps": {
    "scafo": {
      "fleets": [
        {
          "name": "default",
          "endpoint": "http://127.0.0.1:7400",
          "token": "{env.SCAFO_INGRESS_TOKEN}",
          "prefer": "self",
          "poll_interval": "1s"
        }
      ]
    },
    "http": {
      "servers": {
        "scafo": {
          "listen": [":80"],
          "automatic_https": { "disable": true },
          "routes": [
            {
              "@id": "operator_authored",
              "match": [{ "host": ["operator.test"] }],
              "handle": [{ "handler": "static_response", "status_code": 200, "body": "operator" }],
              "terminal": true
            },
            {
              "@id": "scafo_dynamic",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "dynamic_upstreams": { "source": "scafo" },
                  "load_balancing": {
                    "selection_policy": { "policy": "first" },
                    "retries": 2,
                    "try_duration": "5s"
                  },
                  "health_checks": { "passive": { "fail_duration": "30s", "max_fails": 1 } }
                }
              ]
            }
          ],
          "errors": {
            "routes": [
              {
                "match": [{ "vars": { "scafo.route": ["unknown", "denied"] } }],
                "handle": [
                  {
                    "handler": "static_response",
                    "status_code": 404,
                    "body": "scafo: no route"
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
