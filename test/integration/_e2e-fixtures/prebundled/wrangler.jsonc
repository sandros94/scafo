{
  /* An application whose entry is already a self-contained module, which its own
     config says so that no flag has to. The deploy that publishes it passes
     none: what celld reads is this file exactly as it stands. */
  "name": "app",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "no_bundle": true,
  "vars": { "APP_VERSION": "prebundled" },
}
